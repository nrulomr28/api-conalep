<?php



session_start();



if (!isset($_SESSION["usuario_google"])) {

    header("Location: login.php");

    exit;

}



$usuario = $_SESSION["usuario_google"];



require_once "config.php";



$resultados = [];

$totalResultados = 0;

$buscar = false;
$mensaje = "";


$curp = trim($_GET["curp"] ?? "");

$plantel = trim($_GET["plantel"] ?? "");

$estatus = trim($_GET["estatus"] ?? "");



if ($curp != "" || $plantel != "" || $estatus != "") {



    $buscar = true;



    $sql = "SELECT

                curp_alumno,

                nia_alumno,

                apaterno_alumno,

                amaterno_alumno,

                nombre_alumno,

                plantel_alumno,

                direccion_alumno,

                estatus_alumno,

                menorEdad_alumno,

                nombre_tutor,

                curp_tutor,

                telefono_tutor

            FROM conalep_1_2026

            WHERE 1=1";



    $parametros = [];



    if ($curp != "") {

        $sql .= " AND curp_alumno = :curp";

        $parametros["curp"] = $curp;

    }



    if ($plantel != "") {

        $sql .= " AND plantel_alumno = :plantel";

        $parametros["plantel"] = $plantel;

    }



    if ($estatus != "") {

        $sql .= " AND estatus_alumno = :estatus";

        $parametros["estatus"] = $estatus;

    }



    $sql .= " ORDER BY apaterno_alumno,nombre_alumno LIMIT 100";



    $stmt = $conexion->prepare($sql);

    $stmt->execute($parametros);



    $resultados = $stmt->fetchAll(PDO::FETCH_ASSOC);

    $totalResultados = count($resultados);

}



?>

